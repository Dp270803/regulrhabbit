{
  "steps": {
    "welcome": {
      "bot_message": "Hey. Let's build your gym plan. What's your main goal?",
      "options": [
        { "label": "Build muscle and get bigger", "value": "muscle", "next": "experience" },
        { "label": "Lose fat and get lean", "value": "fat_loss", "next": "experience" },
        { "label": "Get stronger (powerlifting)", "value": "strength", "next": "experience" },
        { "label": "General fitness and health", "value": "general", "next": "experience" }
      ],
      "field": "gym_goal"
    },
    "experience": {
      "bot_message": "How long have you been lifting consistently?",
      "options": [
        { "label": "Brand new — never trained before", "value": "beginner_new", "next": "days" },
        { "label": "Less than a year, still learning", "value": "beginner", "next": "days" },
        { "label": "1–3 years, decent base", "value": "intermediate", "next": "days" },
        { "label": "3+ years, advanced lifter", "value": "advanced", "next": "days" }
      ],
      "field": "experience_level"
    },
    "days": {
      "bot_message": "How many days a week can you realistically commit?",
      "options": [
        { "label": "2 days — minimum effective dose", "value": 2, "next": "schedule" },
        { "label": "3 days — ideal for most people", "value": 3, "next": "schedule" },
        { "label": "4 days — solid upper/lower split", "value": 4, "next": "schedule" },
        { "label": "5–6 days — high commitment", "value": 5, "next": "schedule" }
      ],
      "field": "frequency"
    },
    "schedule": {
      "bot_message": "Which days work best for you?",
      "type": "multi_select",
      "options": [
        { "label": "Mon", "value": "monday" },
        { "label": "Tue", "value": "tuesday" },
        { "label": "Wed", "value": "wednesday" },
        { "label": "Thu", "value": "thursday" },
        { "label": "Fri", "value": "friday" },
        { "label": "Sat", "value": "saturday" },
        { "label": "Sun", "value": "sunday" }
      ],
      "next": "equipment",
      "field": "scheduled_days"
    },
    "equipment": {
      "bot_message": "What equipment do you have access to?",
      "options": [
        { "label": "Full gym — barbells, dumbbells, machines", "value": "full_gym", "next": "summary" },
        { "label": "Home gym — dumbbells and a bench", "value": "home_dumbbells", "next": "summary" },
        { "label": "Bodyweight only", "value": "bodyweight", "next": "summary" }
      ],
      "field": "equipment"
    },
    "summary": {
      "bot_message": "Perfect. Here's your plan:",
      "type": "summary",
      "next": "confirm"
    },
    "confirm": {
      "bot_message": "Your 4-week gym plan is ready. First session: {first_day}.",
      "options": [
        { "label": "Create my dashboard →", "value": "confirm", "next": "complete" }
      ]
    },
    "complete": {
      "type": "complete",
      "bot_message": "You're in. First session: {first_day}. Just show up."
    }
  },
  "initial_step": "welcome"
}
