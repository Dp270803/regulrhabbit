{
  "steps": {
    "welcome": {
      "bot_message": "Hey. I'm going to help you build a gym habit that actually sticks. First — what's your main goal?",
      "options": [
        { "label": "Build muscle and strength", "value": "muscle", "next": "experience" },
        { "label": "Lose fat and get lean", "value": "fat_loss", "next": "experience" },
        { "label": "Get stronger (powerlifting focus)", "value": "strength", "next": "experience" },
        { "label": "General fitness and stay active", "value": "general", "next": "experience" }
      ],
      "field": "gym_goal"
    },
    "experience": {
      "bot_message": "How long have you been training?",
      "options": [
        { "label": "Never really trained before", "value": "beginner", "next": "past_attempts" },
        { "label": "A few months, still learning the basics", "value": "beginner", "next": "past_attempts" },
        { "label": "1–2 years, but inconsistent", "value": "intermediate", "next": "past_attempts" },
        { "label": "Training consistently for 2+ years", "value": "advanced", "next": "past_attempts" }
      ],
      "field": "experience_level"
    },
    "past_attempts": {
      "bot_message": "Have you tried building a gym habit before?",
      "options": [
        { "label": "No, this is my first real attempt", "value": "neutral", "next": "frequency" },
        { "label": "Yes, but I keep falling off", "value": "restarter", "next": "frequency" },
        { "label": "I go sometimes — I just need a proper system", "value": "stacker", "next": "frequency" },
        { "label": "I have a specific goal or deadline", "value": "preparer", "next": "goal_type" }
      ],
      "field": "persona"
    },
    "goal_type": {
      "bot_message": "What's the goal you're training for?",
      "options": [
        { "label": "Body transformation (12-week program)", "value": "transformation", "next": "frequency" },
        { "label": "Competition or photoshoot", "value": "performance", "next": "frequency" },
        { "label": "Just get consistent by a target date", "value": "consistency", "next": "frequency" }
      ],
      "field": "goal_type"
    },
    "frequency": {
      "bot_message": "How many days a week can you realistically commit? Be honest — less is more.",
      "options": [
        { "label": "2 days", "value": 2, "next": "duration" },
        { "label": "3 days", "value": 3, "next": "duration" },
        { "label": "4 days", "value": 4, "next": "duration" },
        { "label": "5+ days", "value": 5, "next": "duration" }
      ],
      "field": "frequency",
      "restarter_warning": {
        "condition": { "persona": "restarter", "value": 5 },
        "message": "I respect the ambition — but starting with 5 days is the #1 reason people burn out and quit. Research says starting smaller builds stronger habits. Want to start with 3 days and add more after week 2?",
        "options": [
          { "label": "You're right, let's do 3", "value": 3, "next": "duration" },
          { "label": "I'll stick with 5+", "value": 5, "next": "duration" }
        ]
      }
    },
    "duration": {
      "bot_message": "How long do you want each session to be?",
      "options": [
        { "label": "30 minutes (quick and focused)", "value": 30, "next": "schedule" },
        { "label": "45 minutes", "value": 45, "next": "schedule" },
        { "label": "60 minutes", "value": 60, "next": "schedule" },
        { "label": "75+ minutes (full sessions)", "value": 75, "next": "schedule" }
      ],
      "field": "session_duration"
    },
    "schedule": {
      "bot_message": "Which days work best for you?",
      "type": "multi_select",
      "options": [
        { "label": "Mon", "value": "monday" },
        { "label": "Tue", "value": "tuesday" },
        { "label": "Wed", "value": "wednesday" },
        { "label": "Thu", "value": "thursday" },
        { "label": "Fri", "value": "friday" },
        { "label": "Sat", "value": "saturday" },
        { "label": "Sun", "value": "sunday" }
      ],
      "next": "equipment",
      "field": "scheduled_days"
    },
    "equipment": {
      "bot_message": "What equipment do you have access to?",
      "options": [
        { "label": "Full gym (machines + barbells + free weights)", "value": "full_gym", "next": "time_preference" },
        { "label": "Gym with mostly dumbbells and cables", "value": "dumbbells_cables", "next": "time_preference" },
        { "label": "Home gym (dumbbells + bench)", "value": "home_dumbbells", "next": "time_preference" },
        { "label": "Bodyweight only", "value": "bodyweight", "next": "time_preference" }
      ],
      "field": "equipment"
    },
    "time_preference": {
      "bot_message": "When do you usually go to the gym?",
      "options": [
        { "label": "Morning (before work/school)", "value": "morning", "next": "summary" },
        { "label": "Afternoon / lunch break", "value": "afternoon", "next": "summary" },
        { "label": "Evening (after work)", "value": "evening", "next": "summary" },
        { "label": "No set time, it varies", "value": "none", "next": "summary" }
      ],
      "field": "preferred_time"
    },
    "summary": {
      "bot_message": "Perfect. Here's what I've got:",
      "type": "summary",
      "next": "confirm"
    },
    "confirm": {
      "bot_message": "Your 4-week gym plan is ready. It starts on {first_day}.",
      "options": [
        { "label": "Show me my plan →", "value": "confirm", "next": "complete" }
      ]
    },
    "complete": {
      "type": "complete",
      "bot_message": "Welcome to Regulr. Your first session is {first_day}. Just show up."
    }
  },
  "initial_step": "welcome"
}
