      "weeks": [
        { "week_number": 1, "sessions": [
          { "day_index": 0, "title": "Vocal Foundations", "duration_minutes": 25, "blocks": [{ "type": "warmup", "detail": "5 min lip trills (ascending/descending), gentle humming, siren slides low to high", "duration_minutes": 5 }, { "type": "main", "detail": "10 min breath support: diaphragmatic breathing exercises, sustained 'ss' and 'sh' sounds (15s holds ×5). Pitch matching: play single notes and match them.", "duration_minutes": 15 }, { "type": "cooldown", "detail": "5 min cool-down: gentle humming, yawning stretches, neck rolls", "duration_minutes": 5 }] },
          { "day_index": 1, "title": "Range Finding", "duration_minutes": 25, "blocks": [{ "type": "warmup", "detail": "5 min lip trills + 'ng' hums ascending scales", "duration_minutes": 5 }, { "type": "main", "detail": "Find comfortable range: sing 'ah' up the scale until strain, then down. Note your range. Sing a simple melody in your comfortable range.", "duration_minutes": 15 }, { "type": "cooldown", "detail": "Gentle humming cool-down + hydrate", "duration_minutes": 5 }] }
        ]},
        { "week_number": 2, "sessions": [
