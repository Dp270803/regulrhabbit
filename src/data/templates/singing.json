          { "day_index": 1, "title": "Song Practice", "duration_minutes": 30, "blocks": [{ "type": "warmup", "detail": "Lip trills + scale warm-up (5 min)", "duration_minutes": 5 }, { "type": "main", "detail": "Verse 1 of chosen song: focus on pitch accuracy. Sing along with original, then a cappella. Record and listen back.", "duration_minutes": 20 }, { "type": "cooldown", "detail": "Gentle humming", "duration_minutes": 5 }] }
        ]},
        { "week_number": 3, "sessions": [
