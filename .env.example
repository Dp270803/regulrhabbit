# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Sanity CMS — get these from sanity.io/manage → your project → Settings → API
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_TOKEN=your_sanity_token

# Supabase — get from supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic — server-side only (Netlify Functions), never use VITE_ prefix for this
# Add this to Netlify environment variables (not in this file for local dev)
ANTHROPIC_API_KEY=your_anthropic_api_key
